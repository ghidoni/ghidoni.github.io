---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/writing', label: 'writing' },
  { href: '/notes', label: 'notes' },
  { href: '/search', label: 'search' },
];
---

<header class="site-header wrap">
  <a class="prompt" href="/">
    <span class="tilde">~</span>/<span class="caret">_</span>
  </a>

  <nav class="site-nav" aria-label="Main">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href || path.startsWith(`${link.href}/`) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
      <svg class="icon icon-moon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
        <path
          fill="currentColor"
          d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
        ></path>
      </svg>
      <svg class="icon icon-sun" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2"></path>
          <path d="M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"></path>
        </g>
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode: fall back to per-page default */
      }
    });
  })();
</script>
