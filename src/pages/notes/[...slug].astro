---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, slugifyTag } from '../../lib/utils';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const updated = note.data.updated ?? note.data.created;
---

<Base title={note.data.title} description={note.data.summary} type="article">
  <article data-pagefind-body data-pagefind-filter="section:Notes">
    <header class="post-head">
      <div class="meta" data-pagefind-ignore>
        <a href="/notes/">~/notes</a>
        {updated && <span>last reviewed {formatDate(updated)}</span>}
      </div>
      <h1>{note.data.title}</h1>
      <p class="summary">{note.data.summary}</p>
      {
        note.data.tags.length > 0 && (
          <div class="tags">
            {note.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${slugifyTag(tag)}/`}>
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post-head .meta a {
    color: var(--text-low);
    text-decoration: none;
  }
  .post-head .meta a:hover {
    color: var(--accent);
  }
</style>
